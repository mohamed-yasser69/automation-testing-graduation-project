<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- OrangeHRM graduation project.
     parallel="tests": every <test> block runs on its own thread (3 at a time). Classes inside one
     <test> run one after another on that thread, so the ThreadLocal<WebDriver> in DriverManager
     gives each thread its own independent browser. -->
<suite name="OrangeHRM Automation Suite" parallel="tests" thread-count="3">

    <listeners>
        <listener class-name="listeners.TestListener"/>
        <listener class-name="listeners.RetryListener"/>
    </listeners>

    <test name="Login Tests">
        <classes>
            <class name="tests.orangehrm.LoginTest"/>
        </classes>
    </test>

    <test name="PIM Employee Tests">
        <classes>
            <class name="tests.orangehrm.PimEmployeeTest"/>
        </classes>
    </test>

    <test name="Admin and UI Tests">
        <classes>
            <class name="tests.orangehrm.AdminTest"/>
            <class name="tests.orangehrm.UiTest"/>
        </classes>
    </test>
</suite>

